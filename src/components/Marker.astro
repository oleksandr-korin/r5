---
/* The hand-drawn amber underline that goes under the "marked" word in headings.
   Inline SVG (vs CSS background) so it always paints and recolours via currentColor. */
---
<span class="r5-mkword">
  <slot />
  <svg class="r5-mkline" viewBox="0 0 320 24" preserveAspectRatio="none" aria-hidden="true">
    <path d="M4 13.5 C 60 9.5 130 8.5 196 10 C 244 11 286 12.5 314 11 C 300 14.5 250 15.5 196 15 C 130 14.5 64 15.5 6 18 C 3 18 2 14 4 13.5 Z" fill="currentColor"/>
  </svg>
</span>
