---
import Icon from "../Icon.astro";
import T from "../T.astro";
import { CONTACT } from "../../lib/contact";
const uk = CONTACT.uk.online;
const en = CONTACT.en.online;
---
<section class="r5-calt" id="online-alt">
  <div class="r5-wrap r5-calt__in">
    <span class="r5-calt__text"><T uk={uk.text} en={en.text} /></span>
    <a class="r5-link" href="/online">
      <T uk={uk.link} en={en.link} />
      <Icon name="arrow-right" size={16} />
    </a>
  </div>
</section>
