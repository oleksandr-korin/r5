---
import Marker from "../Marker.astro";
import T from "../T.astro";
import { zipLocales } from "../../lib/strings";
import { GYM } from "../../lib/gym";
const uk = GYM.uk.gallery;
const en = GYM.en.gallery;
const items = zipLocales(uk.items, en.items);
---
<section class="r5-section r5-gallery" id="gallery">
  <div class="r5-wrap">
    <div class="r5-sechead">
      <p class="r5-eyebrow-row"><T uk={uk.eyebrow} en={en.eyebrow} /></p>
      <h2>
        <T uk={uk.title} en={en.title} />
        {" "}
        <Marker><T uk={uk.marked} en={en.marked} /></Marker>
      </h2>
    </div>
    <div class="r5-gallery__grid">
      {items.map(({ u, e }) => (
        <div class="r5-gphoto">
          <div class="r5-photo-ph"><T uk={u.k} en={e.k} /></div>
          <span class="r5-gphoto__cap"><T uk={u.t} en={e.t} /></span>
        </div>
      ))}
    </div>
  </div>
</section>
