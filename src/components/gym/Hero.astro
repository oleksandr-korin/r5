---
import Icon from "../Icon.astro";
import Marker from "../Marker.astro";
import T from "../T.astro";
import { GYM } from "../../lib/gym";
const uk = GYM.uk.hero;
const en = GYM.en.hero;
---
<header class="r5-ghero r5-dark" id="top">
  <div class="r5-wrap r5-ghero__grid">
    <div class="r5-ghero__in">
      <p class="r5-eyebrow-row"><T uk={uk.eyebrow} en={en.eyebrow} /></p>
      <h1>
        <T uk={uk.title} en={en.title} />
        {" "}
        <Marker><T uk={uk.marked} en={en.marked} /></Marker>
      </h1>
      <p class="r5-ghero__sub"><T uk={uk.sub} en={en.sub} /></p>
      <a class="r5-btn r5-btn--primary r5-btn--cta" href="/contact">
        <T uk={uk.cta} en={en.cta} />
        <Icon name="arrow-right" size={20} />
      </a>
    </div>

    <div class="r5-ghero__plate">
      {/* Silent loop — vertical native frame. Poster paints first so LCP isn't blocked. */}
      <video
        class="r5-ghero__video"
        src="/videos/gym-hero.mp4"
        poster="/images/gym-hero-poster.jpg"
        autoplay muted loop playsinline preload="metadata"
        aria-hidden="true"
      ></video>
    </div>
  </div>
</header>
