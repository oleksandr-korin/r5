---
import Icon from "../Icon.astro";
import Marker from "../Marker.astro";
import T from "../T.astro";
import { zipLocales } from "../../lib/strings";
import { GYM } from "../../lib/gym";
const uk = GYM.uk.practical;
const en = GYM.en.practical;
const blocks = zipLocales(uk.blocks, en.blocks);
const mapsUrl = "https://www.google.com/maps/dir/?api=1&destination=5+Robocha+St,+Dnipro";
---
<section class="r5-section" id="practical" style="background: var(--surface)">
  <div class="r5-wrap">
    <div class="r5-sechead">
      <p class="r5-eyebrow-row"><T uk={uk.eyebrow} en={en.eyebrow} /></p>
      <h2>
        <T uk={uk.title} en={en.title} />
        {" "}
        <Marker><T uk={uk.marked} en={en.marked} /></Marker>
      </h2>
    </div>
    <div class="r5-prac__grid">
      <div class="r5-prac__map">
        <div class="r5-photo-ph"><T uk={uk.mapPh} en={en.mapPh} /></div>
        <div class="r5-prac__mapcta">
          <a class="r5-btn r5-btn--primary" href={mapsUrl} target="_blank" rel="noopener">
            <Icon name="map-pin" size={18} />
            <T uk={uk.mapCta} en={en.mapCta} />
          </a>
        </div>
      </div>
      <div class="r5-prac__blocks">
        {blocks.map(({ u, e }) => (
          <div class="r5-prac__b">
            <h4><T uk={u.h} en={e.h} /></h4>
            <ul>
              {u.items.map((it, i) => (<li><T uk={it} en={e.items[i]} /></li>))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
