---
import Marker from "../Marker.astro";
import Tick from "../Tick.astro";
import T from "../T.astro";
import { zipLocales } from "../../lib/strings";
import { GYM } from "../../lib/gym";
const uk = GYM.uk.whatis;
const en = GYM.en.whatis;
const ticks = zipLocales(uk.ticks, en.ticks);
---
<section class="r5-section r5-whatis" id="about">
  <div class="r5-wrap r5-whatis__grid">
    <div class="r5-whatis__photo">
      <img class="r5-plate__img" src="/images/site/whatis.jpg"
           alt="Зал R5 у Дніпрі — простір функціонального тренінгу з бетоном і фанерою"
           width="1800" height="1200" loading="lazy" />
    </div>
    <div>
      <p class="r5-eyebrow-row"><T uk={uk.eyebrow} en={en.eyebrow} /></p>
      <h2>
        <T uk={uk.title} en={en.title} />
        {" "}
        <Marker><T uk={uk.marked} en={en.marked} /></Marker>
      </h2>
      <p class="r5-whatis__body"><T uk={uk.body} en={en.body} /></p>
      <ul class="r5-ticks">
        {ticks.map(({ u, e }) => (<li><Tick /><T uk={u} en={e} /></li>))}
      </ul>
    </div>
  </div>
</section>
