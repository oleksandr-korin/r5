---
import Marker from "../Marker.astro";
import T from "../T.astro";
import { zipLocales } from "../../lib/strings";
import { COACH } from "../../lib/coach";
const uk = COACH.uk.creds;
const en = COACH.en.creds;
const items = zipLocales(uk.items, en.items);
---
<section class="r5-section" id="creds">
  <div class="r5-wrap">
    <div class="r5-sechead">
      <p class="r5-eyebrow-row"><T uk={uk.eyebrow} en={en.eyebrow} /></p>
      <h2>
        <T uk={uk.title} en={en.title} />
        {" "}
        <Marker><T uk={uk.marked} en={en.marked} /></Marker>
      </h2>
    </div>
    <div class="r5-creds">
      {items.map(({ u, e }) => (
        <div class="r5-cred">
          <h3 class="r5-cred__t"><T uk={u.t} en={e.t} /></h3>
          <p class="r5-cred__s"><T uk={u.s} en={e.s} /></p>
        </div>
      ))}
    </div>
  </div>
</section>
