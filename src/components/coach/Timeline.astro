---
import Marker from "../Marker.astro";
import T from "../T.astro";
import { zipLocales } from "../../lib/strings";
import { COACH } from "../../lib/coach";
const uk = COACH.uk.timeline;
const en = COACH.en.timeline;
const items = zipLocales(uk.items, en.items);
---
<section class="r5-section" id="record" style="background: var(--surface)">
  <div class="r5-wrap">
    <div class="r5-sechead">
      <p class="r5-eyebrow-row"><T uk={uk.eyebrow} en={en.eyebrow} /></p>
      <h2>
        <T uk={uk.title} en={en.title} />
        {" "}
        <Marker><T uk={uk.marked} en={en.marked} /></Marker>
      </h2>
    </div>
    <div class="r5-tl">
      {items.map(({ u, e }) => (
        <div class="r5-tl__row">
          <div class="r5-tl__year">{u.y}</div>
          <div class="r5-tl__body">
            <span class="r5-tl__node"></span>
            <h3 class="r5-tl__t"><T uk={u.t} en={e.t} /></h3>
            {u.d && <p class="r5-tl__d"><T uk={u.d} en={e.d!} /></p>}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
