---
import Icon from "../Icon.astro";
import Marker from "../Marker.astro";
import T from "../T.astro";
import { zipLocales } from "../../lib/strings";
import { RESULTS } from "../../lib/results";
const uk = RESULTS.uk.stories;
const en = RESULTS.en.stories;
const items = zipLocales(uk.items, en.items);
// Photo paths matched to stories.items order in src/lib/results.ts:
// 0 Iryna, 1 Andrii, 2 Serhii
const photos = [
  "/images/site/story-iryna.jpg",
  "/images/site/story-andrii.jpg",
  "/images/site/r-warmup.jpg",
];
---
<section class="r5-section" id="stories" style="background: var(--surface)">
  <div class="r5-wrap">
    <div class="r5-sechead">
      <p class="r5-eyebrow-row"><T uk={uk.eyebrow} en={en.eyebrow} /></p>
      <h2>
        <T uk={uk.title} en={en.title} />
        {" "}
        <Marker><T uk={uk.marked} en={en.marked} /></Marker>
      </h2>
    </div>
    <div class="r5-stories__grid">
      {items.map(({ u, e }, i) => (
        <div class="r5-card r5-card--stamp r5-story">
          <div class="r5-story__photo">
            <img class="r5-plate__img" src={photos[i]} alt={u.name}
                 width="1000" height="1333" loading="lazy" />
          </div>
          <div class="r5-story__body">
            <span class="r5-story__tag"><T uk={u.tag} en={e.tag} /></span>
            <h3><T uk={u.name} en={e.name} /></h3>
            <div class="r5-story__arc">
              <span class="r5-story__chip"><T uk={u.from} en={e.from} /></span>
              <span class="r5-story__arrow"><Icon name="arrow-right" size={16} /></span>
              <span class="r5-story__chip r5-story__chip--now"><T uk={u.to} en={e.to} /></span>
            </div>
            <p class="r5-story__text"><T uk={u.body} en={e.body} /></p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
