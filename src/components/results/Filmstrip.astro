---
import Marker from "../Marker.astro";
import T from "../T.astro";
import { zipLocales } from "../../lib/strings";
import { RESULTS } from "../../lib/results";
const uk = RESULTS.uk.gallery;
const en = RESULTS.en.gallery;
const items = zipLocales(uk.items, en.items);
// Photo paths in the same order as gallery.items in src/lib/results.ts:
// 0 full floor, 1 competition day, 2 scoreboard, 3 after session, 4 platform, 5 warm-up
const photos = [
  "/images/site/box.jpg",
  "/images/site/coach-card.jpg",
  "/images/site/r-platform.jpg",
  "/images/site/r-after.jpg",
  "/images/site/g-platform.jpg",
  "/images/site/r-warmup.jpg",
];
---
<section class="r5-section" id="community">
  <div class="r5-wrap">
    <div class="r5-sechead">
      <p class="r5-eyebrow-row"><T uk={uk.eyebrow} en={en.eyebrow} /></p>
      <h2>
        <T uk={uk.title} en={en.title} />
        {" "}
        <Marker><T uk={uk.marked} en={en.marked} /></Marker>
      </h2>
    </div>
    <div class="r5-film">
      {items.map(({ u, e }, i) => (
        <div class="r5-film__item">
          <img class="r5-plate__img" src={photos[i]} alt={u.t}
               width="1000" height="1500" loading="lazy" />
          <span class="r5-film__cap"><T uk={u.t} en={e.t} /></span>
        </div>
      ))}
    </div>
  </div>
</section>
