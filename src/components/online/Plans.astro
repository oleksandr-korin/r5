---
import Tick from "../Tick.astro";
import Marker from "../Marker.astro";
import T from "../T.astro";
import { zipLocales } from "../../lib/strings";
import { ONLINE } from "../../lib/online";
const uk = ONLINE.uk.plans;
const en = ONLINE.en.plans;
const plans = zipLocales(uk.items, en.items);
---
<section class="r5-section r5-pricing" id="plans">
  <div class="r5-wrap">
    <div class="r5-pricing__head">
      <div class="r5-sechead">
        <p class="r5-eyebrow-row"><T uk={uk.eyebrow} en={en.eyebrow} /></p>
        <h2>
          <T uk={uk.title} en={en.title} />
          {" "}
          <Marker><T uk={uk.marked} en={en.marked} /></Marker>
        </h2>
      </div>
      <p class="r5-pricing__note"><T uk={uk.note} en={en.note} /></p>
    </div>
    <div class="r5-prices">
      {plans.map(({ u, e }) => (
        <div class={"r5-price" + (u.popular ? " r5-price--popular" : "")}>
          {u.popular && (
            <span class="r5-price__flag"><T uk={uk.popular} en={en.popular} /></span>
          )}
          <p class="r5-price__name"><T uk={u.name} en={e.name} /></p>
          <div class="r5-price__amount">
            <span class="r5-price__num"><T uk={u.price} en={e.price} /></span>
            <span class="r5-price__per"><T uk={u.per} en={e.per} /></span>
          </div>
          <ul class="r5-price__items">
            {u.items.map((it, i) => (<li><Tick /><T uk={it} en={e.items[i]} /></li>))}
          </ul>
          <a class="r5-btn r5-btn--primary r5-btn--cta" href="#apply">
            <T uk={uk.cta} en={en.cta} />
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
