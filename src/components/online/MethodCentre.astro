---
import T from "../T.astro";
import { zipLocales } from "../../lib/strings";
import { ONLINE } from "../../lib/online";
const uk = ONLINE.uk.method;
const en = ONLINE.en.method;
const cols = zipLocales(uk.cols, en.cols);
---
<section class="r5-section" id="method">
  <div class="r5-wrap">
    <div class="r5-mthd__panel">
      <div class="r5-mthd__head">
        <div>
          <p class="r5-eyebrow-row"><T uk={uk.eyebrow} en={en.eyebrow} /></p>
          <h2><T uk={uk.title} en={en.title} /></h2>
        </div>
        <span class="r5-mthd__tag"><T uk={uk.tag} en={en.tag} /></span>
      </div>
      <p class="r5-mthd__lead"><T uk={uk.lead} en={en.lead} /></p>
      <div class="r5-mthd__cols">
        {cols.map(({ u, e }) => (
          <div class="r5-mthd__col">
            <div class="r5-mthd__n">{u.n}</div>
            <h3 class="r5-mthd__t"><T uk={u.t} en={e.t} /></h3>
            <p class="r5-mthd__d"><T uk={u.d} en={e.d} /></p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
