---
interface Props { size?: number; }
const { size = 26 } = Astro.props;
---
<a class="r5-mark" href="#top" style={`font-size:${size}px`} data-scroll-top>
  <img class="r5-mark__logo r5-mark__logo--light" src="/assets/r5-logo.svg" alt="" aria-hidden="true" />
  <img class="r5-mark__logo r5-mark__logo--dark"  src="/assets/r5-logo-ondark.svg" alt="" aria-hidden="true" />
  <span class="r5-mark__word">
    <span class="i18n" data-uk="Рокитний" data-en="Rokytnyi">Рокитний</span><span class="five">5</span>
  </span>
</a>

<style>
  .r5-mark__logo--dark { display: none; }
  :global(.r5-dark) .r5-mark__logo--light { display: none; }
  :global(.r5-dark) .r5-mark__logo--dark  { display: block; }
</style>
