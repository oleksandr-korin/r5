---
/* Lucide icon paths used across R5. Bundled here so a single component
   handles size, stroke, and currentColor recolouring. */
type IconName =
  | "arrow-right" | "arrow-down" | "menu" | "x"
  | "phone" | "map-pin" | "clock" | "instagram"
  | "send" | "mail" | "sun" | "moon" | "monitor";

interface Props { name: IconName; size?: number; class?: string; }
const { name, size = 22, class: cls } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cls}
  aria-hidden="true"
>
  {name === "arrow-right" && (<><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></>)}
  {name === "arrow-down"  && (<><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></>)}
  {name === "menu"        && (<><path d="M4 12h16"/><path d="M4 6h16"/><path d="M4 18h16"/></>)}
  {name === "x"           && (<><path d="M18 6 6 18"/><path d="m6 6 12 12"/></>)}
  {name === "phone"       && (<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>)}
  {name === "map-pin"     && (<><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></>)}
  {name === "clock"       && (<><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></>)}
  {name === "instagram"   && (<><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></>)}
  {name === "send"        && (<><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></>)}
  {name === "mail"        && (<><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></>)}
  {name === "sun"         && (<><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></>)}
  {name === "moon"        && (<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>)}
  {name === "monitor"     && (<><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></>)}
</svg>
