---
import T from "../T.astro";
import { zipLocales } from "../../lib/strings";
import { TRAINING } from "../../lib/training";
const uk = TRAINING.uk.flow;
const en = TRAINING.en.flow;
const steps = zipLocales(uk.steps, en.steps);
---
<section class="r5-section r5-flow" id="flow" style="background: var(--surface)">
  <div class="r5-wrap">
    <div class="r5-flow__panel">
      <div class="r5-flow__head">
        <div>
          <p class="r5-eyebrow-row"><T uk={uk.eyebrow} en={en.eyebrow} /></p>
          <h2><T uk={uk.title} en={en.title} /></h2>
        </div>
        <p class="r5-flow__lead"><T uk={uk.lead} en={en.lead} /></p>
      </div>
      <div class="r5-flow__steps">
        {steps.map(({ u, e }) => (
          <div class="r5-flow__step">
            <div class="r5-flow__n">{u.n}</div>
            <h3 class="r5-flow__st"><T uk={u.t} en={e.t} /></h3>
            <p class="r5-flow__sd"><T uk={u.d} en={e.d} /></p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
