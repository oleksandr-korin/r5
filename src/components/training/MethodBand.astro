---
import Icon from "../Icon.astro";
import T from "../T.astro";
import { TRAINING } from "../../lib/training";
const uk = TRAINING.uk.method;
const en = TRAINING.en.method;
---
<section class="r5-section r5-method r5-dark" id="method">
  <div class="r5-method__tag" aria-hidden="true">HRV</div>
  <div class="r5-wrap r5-method__grid">
    <div>
      <p class="r5-eyebrow-row"><T uk={uk.eyebrow} en={en.eyebrow} /></p>
      <h2><T uk={uk.title} en={en.title} /></h2>
      <p class="r5-method__body"><T uk={uk.body} en={en.body} /></p>
    </div>
    <div class="r5-method__cta">
      <a class="r5-link" href="/coach#method">
        <T uk={uk.link} en={en.link} />
        <Icon name="arrow-right" size={18} />
      </a>
    </div>
  </div>
</section>
