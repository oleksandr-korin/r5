---
import Tick from "../Tick.astro";
import Icon from "../Icon.astro";
import T from "../T.astro";
import { STRINGS, zipLocales } from "../../lib/strings";
const uk = STRINGS.uk.coach;
const en = STRINGS.en.coach;
const creds = zipLocales(uk.creds, en.creds);
---
<section class="r5-section r5-coach" id="coach">
  <div class="r5-wrap r5-coach__grid">
    <div class="r5-coach__photo">
      <img class="r5-plate__img" src="/images/site/coach-card.jpg"
           alt="Dmytro Pasichnyi coaching members at R5"
           width="1600" height="1067" loading="lazy" />
    </div>

    <div>
      <p class="r5-coach__name">
        <T uk={uk.eyebrow} en={en.eyebrow} />
        {" · "}
        <T uk={uk.name} en={en.name} />
      </p>

      <h2><T uk={uk.title} en={en.title} /></h2>

      <p class="r5-coach__body"><T uk={uk.body} en={en.body} /></p>

      <ul class="r5-coach__creds">
        {creds.map(({ u, e }) => (
          <li><Tick /><T uk={u} en={e} /></li>
        ))}
      </ul>

      <a class="r5-link" href="/coach">
        <T uk={uk.link} en={en.link} />
        <Icon name="arrow-right" size={18} />
      </a>
    </div>
  </div>
</section>
