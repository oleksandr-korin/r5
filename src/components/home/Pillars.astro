---
import Marker from "../Marker.astro";
import T from "../T.astro";
import { STRINGS, zipLocales } from "../../lib/strings";
const uk = STRINGS.uk.pillars;
const en = STRINGS.en.pillars;
const items = zipLocales(uk.items, en.items);
---
<section class="r5-section" id="why">
  <div class="r5-wrap">
    <div class="r5-sechead">
      <p class="r5-eyebrow-row"><T uk={uk.eyebrow} en={en.eyebrow} /></p>
      <h2>
        <T uk={uk.title} en={en.title} />
        {" "}
        <Marker><T uk={uk.marked} en={en.marked} /></Marker>
      </h2>
    </div>

    <div class="r5-pillars">
      {items.map(({ u, e }) => (
        <div class="r5-card r5-card--tab r5-card--stamp r5-pillar">
          <div class="r5-pillar__top">
            <span class="r5-pillar__n">{u.n}</span>
            <span class="r5-badge r5-badge--amber"><T uk={u.tag} en={e.tag} /></span>
          </div>
          <h3><T uk={u.t} en={e.t} /></h3>
          <p><T uk={u.d} en={e.d} /></p>
        </div>
      ))}
    </div>
  </div>
</section>
