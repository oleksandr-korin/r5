---
import Icon from "../Icon.astro";
import Marker from "../Marker.astro";
import T from "../T.astro";
import { STRINGS, splitMarked } from "../../lib/strings";

const uk = STRINGS.uk.hero;
const en = STRINGS.en.hero;
const ukT = splitMarked(uk.title, uk.marked);
const enT = splitMarked(en.title, en.marked);
---
<header class="r5-hero r5-dark" id="top">
  <div class="r5-hero__bg"></div>
  <div class="r5-hero__scrim"></div>

  <div class="r5-wrap r5-hero__grid">
    <div>
      <p class="r5-eyebrow-row"><T uk={uk.eyebrow} en={en.eyebrow} /></p>

      <h1>
        <T uk={ukT.before} en={enT.before} />
        <Marker><T uk={uk.marked} en={en.marked} /></Marker>
        <T uk={ukT.after} en={enT.after} />
      </h1>

      <p class="r5-hero__sub"><T uk={uk.sub} en={en.sub} /></p>

      <div class="r5-hero__cta">
        <button class="r5-btn r5-btn--primary r5-btn--cta" data-go="contact">
          <T uk={uk.cta} en={en.cta} />
          <Icon name="arrow-right" size={20} />
        </button>

        <a class="r5-hero__ghost" href="/online">
          <Icon name="monitor" size={18} />
          <T uk={uk.ghost} en={en.ghost} />
        </a>
      </div>

      <div class="r5-hero__scrollcue">
        <span class="bar"></span>
        <T uk={uk.scroll} en={en.scroll} />
      </div>
    </div>

    <div class="r5-hero__plate">
      {/* Brand sizzle — silent loop ending on the R5 wordmark. Poster paints first. */}
      <video
        class="r5-hero__video"
        src="/videos/home-hero.mp4"
        poster="/images/home-hero-poster.jpg"
        autoplay muted loop playsinline preload="metadata"
        aria-hidden="true"
      ></video>
    </div>
  </div>
</header>
