---
import Base from "../layouts/Base.astro";
import Nav from "../components/home/Nav.astro";
import Footer from "../components/home/Footer.astro";
import Hero from "../components/coach/Hero.astro";
import OpeningStatement from "../components/coach/OpeningStatement.astro";
import Timeline from "../components/coach/Timeline.astro";
import HrvMethod from "../components/coach/HrvMethod.astro";
import Credentials from "../components/coach/Credentials.astro";
import Athletes from "../components/coach/Athletes.astro";
import PhilosophyQuote from "../components/coach/PhilosophyQuote.astro";
import DualCTA from "../components/coach/DualCTA.astro";
---

<Base
  title="Дмитро Пасічний — тренер, який досі виходить на старт | R5"
  description="Головний тренер R5 у Дніпрі. 25 років коучингу, #1 Masters 40+ в Україні, HRV-метод відновлення. Тренує не вимагаючи — розуміючи."
  lang="uk"
>
  <div class="r5-site" data-vibe="expressive" data-stamp="on">
    <Nav active="coach" />
    <main id="main">
      <Hero />
      <OpeningStatement />
      <Timeline />
      <HrvMethod />
      <Credentials />
      <Athletes />
      <PhilosophyQuote />
      <DualCTA />
    </main>
    <Footer />
  </div>
</Base>
