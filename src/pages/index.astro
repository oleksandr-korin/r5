---
import Base from "../layouts/Base.astro";
import Nav from "../components/home/Nav.astro";
import Hero from "../components/home/Hero.astro";
import ProofBar from "../components/home/ProofBar.astro";
import Box from "../components/home/Box.astro";
import Pillars from "../components/home/Pillars.astro";
import Programs from "../components/home/Programs.astro";
import Coach from "../components/home/Coach.astro";
import Quote from "../components/home/Quote.astro";
import OnlineBand from "../components/home/OnlineBand.astro";
import CtaBand from "../components/home/CtaBand.astro";
import Footer from "../components/home/Footer.astro";
import StickyCTA from "../components/home/StickyCTA.astro";
---

<Base
  title="Кросфіт у Дніпрі — функціональний тренінг | R5 Rokytnyi5"
  description="Кросфіт-зал R5 у Дніпрі: функціональний тренінг, групові класи, персональні тренування. Тренер — Дмитро Пасічний, #1 Masters 40+. Перше тренування безкоштовно."
  lang="uk"
>
  <div class="r5-site" data-vibe="expressive" data-stamp="on">
    <Nav />
    <main id="main">
      <Hero />
      <ProofBar />
      <Box />
      <Pillars />
      <Programs />
      <Coach />
      <Quote />
      <OnlineBand />
      <CtaBand />
    </main>
    <Footer />
    <StickyCTA />
  </div>
</Base>
