---
import Base from "../layouts/Base.astro";
import Nav from "../components/home/Nav.astro";
import Footer from "../components/home/Footer.astro";
import CtaBand from "../components/home/CtaBand.astro";
import StickyCTA from "../components/home/StickyCTA.astro";
import Hero from "../components/gym/Hero.astro";
import WhatIs from "../components/gym/WhatIs.astro";
import Beyond from "../components/gym/Beyond.astro";
import Ritual from "../components/gym/Ritual.astro";
import Gallery from "../components/gym/Gallery.astro";
import TypicalClass from "../components/gym/TypicalClass.astro";
import Practical from "../components/gym/Practical.astro";
---

<Base
  title="Кросфіт-зал у Дніпрі — простір, продуманий до дрібниць | R5"
  description="Кросфіт-зал R5 у Дніпрі: обладнання світових брендів, індивідуальні сейфи, фільтрована вода, кава й коворкінг. Простір, у який хочеться повертатись."
  lang="uk"
>
  <div class="r5-site" data-vibe="expressive" data-stamp="on">
    <Nav active="gym" />
    <main id="main">
      <Hero />
      <WhatIs />
      <Beyond />
      <Ritual />
      <Gallery />
      <TypicalClass />
      <Practical />
      <CtaBand />
    </main>
    <Footer />
    <StickyCTA />
  </div>
</Base>
