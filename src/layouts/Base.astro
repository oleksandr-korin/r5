---
import "../styles/global.css";
import LocalBusinessSchema from "../components/seo/LocalBusinessSchema.astro";

interface Props {
  title: string;
  description?: string;
  lang?: "uk" | "en";
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = "R5 Rokytnyi5 — функціональний тренінг у Дніпрі.",
  lang = "uk",
  ogImage = "/og-default.jpg",
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang={lang} class="r5-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* Production should self-host the OFL display + body faces. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link rel="icon" href="/assets/r5-logo.svg" />

    <LocalBusinessSchema />

    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="r5-skip">Skip to content</a>

    <slot />

    <script is:inline>
      // ---- Locale toggle ----------------------------------------------------
      const storageLocale = (() => { try { return localStorage.getItem("r5:locale"); } catch { return null; } })();
      const serverLocale  = document.documentElement.lang === "en" ? "en" : "uk";
      const initialLocale = storageLocale === "en" || storageLocale === "uk" ? storageLocale : serverLocale;

      function syncLocaleButtons(locale) {
        document.querySelectorAll("[data-locale-btn]").forEach((btn) => {
          btn.setAttribute("aria-pressed", btn.getAttribute("data-locale-btn") === locale ? "true" : "false");
        });
      }

      function applyLocale(locale) {
        document.documentElement.lang = locale;
        const attr = locale === "en" ? "data-en" : "data-uk";
        document.querySelectorAll(".i18n").forEach((el) => {
          const next = el.getAttribute(attr);
          if (next != null) el.textContent = next;
        });
        document.querySelectorAll(".i18n-attr").forEach((el) => {
          const target = el.getAttribute("data-attr") || "placeholder";
          const next = el.getAttribute(attr);
          if (next != null) el.setAttribute(target, next);
        });
        syncLocaleButtons(locale);
        try { localStorage.setItem("r5:locale", locale); } catch {}
      }

      document.querySelectorAll("[data-locale-btn]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const next = btn.getAttribute("data-locale-btn");
          if (next === document.documentElement.lang) return;
          applyLocale(next);
        });
      });

      // Server renders UK by default. If the stored locale matches we still
      // need to call applyLocale once so the locale-driven font picker runs.
      applyLocale(initialLocale);

      // ---- Smooth scroll for [data-go] links --------------------------------
      document.addEventListener("click", (e) => {
        const target = e.target instanceof Element ? e.target.closest("[data-go]") : null;
        if (!target) return;
        const id = target.getAttribute("data-go");
        if (!id) return;
        const el = document.getElementById(id);
        if (!el) return;
        e.preventDefault();
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const y = el.getBoundingClientRect().top + window.scrollY - 84;
        window.scrollTo({ top: y, behavior: reduce ? "auto" : "smooth" });
        const mob = document.querySelector(".r5-mobnav");
        if (mob) mob.classList.remove("open");
      });

      // ---- Sticky CTA on mobile --------------------------------------------
      // Only flip the class on transitions so we don't dirty style every scroll.
      const sticky = document.querySelector(".r5-stickycta");
      if (sticky) {
        let shown = false;
        const update = () => {
          const contact = document.getElementById("contact");
          const past = window.scrollY > 560;
          const nearForm = contact && contact.getBoundingClientRect().top < window.innerHeight * 0.9;
          const next = past && !nearForm;
          if (next === shown) return;
          shown = next;
          sticky.classList.toggle("show", shown);
        };
        update();
        window.addEventListener("scroll", update, { passive: true });
      }

      // ---- Mobile nav burger ------------------------------------------------
      const burger = document.querySelector(".r5-nav__burger");
      const mob    = document.querySelector(".r5-mobnav");
      if (burger && mob) {
        burger.addEventListener("click", () => mob.classList.toggle("open"));
      }
    </script>
  </body>
</html>
